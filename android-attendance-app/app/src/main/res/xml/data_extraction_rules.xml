<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="session_prefs.preferences_pb"/>
        <exclude domain="database" path="attendance_tracker_db"/>
    </cloud-backup>
    <device-transfer>
        <!-- Allow device transfer but exclude sensitive data -->
        <exclude domain="sharedpref" path="session_prefs.preferences_pb"/>
        <exclude domain="database" path="attendance_tracker_db"/>
    </device-transfer>
</data-extraction-rules>
